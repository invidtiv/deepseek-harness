{
  "name": "@deepseek-ai/dsh-experimental-environment-team",
  "description": "Authenticated distributed teams across independent Harness environments",
  "version": "0.2.1-rc.3",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/environment-team"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./management": {
      "types": "./lib/types/management.d.ts",
      "default": "./lib/management.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/settings-types.d.ts"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./pairing": {
      "types": "./lib/types/pairing.d.ts",
      "default": "./lib/pairing.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/management.js",
    "lib/pairing.js",
    "lib/transport-*.js",
    "lib/session-stream-*.js",
    "lib/pairing-configuration-*.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "proper-lockfile": "4.1.2",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "eventsource-parser": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
